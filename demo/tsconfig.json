{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "types": ["node"],
    "paths": {
      "vue-command-palette": ["../src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "env.d.ts"]
}

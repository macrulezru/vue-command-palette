{
  "name": "@macrulez/vue-command-palette",
  "version": "0.1.0",
  "description": "Command+K palette for Vue 3 — headless, fuzzy search, keyboard navigation, nested palettes",
  "type": "module",
  "main": "./dist/vue-command-palette.cjs",
  "module": "./dist/vue-command-palette.js",
  "exports": {
    ".": {
      "import": "./dist/vue-command-palette.js",
      "require": "./dist/vue-command-palette.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "cd demo && npm run dev"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,vue}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^4.1.7",
    "vue": "^3.4.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "command-palette",
    "command-k",
    "fuzzy-search",
    "headless"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@macrulez/vue-command-palette",
  "version": "0.2.7",
  "description": "Headless Command+K palette for Vue 3 with fuzzy search, grouped and nested commands, keyboard navigation and async search.",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "homepage": "https://npm.vuecraft.ru/en/packages/vue-command-palette/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/vue-command-palette.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/vue-command-palette/issues"
  },
  "type": "module",
  "main": "./dist/vue-command-palette.cjs",
  "module": "./dist/vue-command-palette.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-command-palette.js",
      "require": "./dist/vue-command-palette.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.js",
      "require": "./dist/nuxt/module.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "vite build && node -e \"require('fs').copyFileSync('src/style.css','dist/style.css')\"",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "cd demo && npm run dev"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,vue}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.5.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^4.1.7",
    "vue": "^3.4.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "command-palette",
    "command-k",
    "fuzzy-search",
    "keyboard-navigation",
    "headless",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
